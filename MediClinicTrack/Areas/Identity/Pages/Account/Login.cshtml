@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="auth-card">
    <h1>MediClinicTrack Portal Login</h1>
    <p class="auth-subtitle">Secure access for patients and healthcare staff</p>

    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="login-alert" role="alert"></div>

        <div class="form-floating mb-3">
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true"
            aria-describedby="Input_Email-error" placeholder="name@example.com" />
            <label asp-for="Input.Email">Email</label>
            <span asp-validation-for="Input.Email" id="Input_Email-error" class="text-danger" aria-live="polite"></span>
        </div>

        <div class="form-floating mb-1">
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true"
                   aria-describedby="password-help Input_Password-error" placeholder="Password" />
            <label asp-for="Input.Password">Password</label>
            <span asp-validation-for="Input.Password" id="Input_Password-error" class="text-danger" aria-live="polite"></span>
        </div>
        <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
            <div id="password-help" class="form-text mt-0">Passwords are at least 10 characters.</div>
            <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
        </div>

        <div class="form-check mb-3">
            <input class="form-check-input" asp-for="Input.RememberMe" />
            <label class="form-check-label" asp-for="Input.RememberMe"></label>
        </div>

        <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>

        <p class="mt-3 mb-0">
            New patient?
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register for an account</a>
        </p>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}